# Copy to .env.local. Real secrets belong only in .env.local (git-ignored).
# Validated in src/lib/env.ts. Defaults below use the fakes, so no keys are needed locally.

# Postgres with the pgvector extension. Local: `docker compose up -d` (matches this URL).
# Production: the pooled connection string from your Neon project dashboard.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobhunter
# Optional: used only by the Prisma CLI (migrations). Production: Neon's direct (unpooled)
# connection string. Falls back to DATABASE_URL when empty.
DIRECT_DATABASE_URL=
# Public origin of the app, no trailing slash. Local: http://localhost:3000. Production: your Vercel URL.
APP_URL=http://localhost:3000
# At least 32 random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# anthropic | google | mock. "anthropic" needs a key from https://console.anthropic.com/;
# "google" (Gemini, free tier available) needs a key from https://aistudio.google.com/apikey
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# voyage | gemini | fake. "voyage" needs a key from https://dash.voyageai.com/; "gemini" reuses
# GOOGLE_GENERATIVE_AI_API_KEY above (free tier). Changing provider needs re-embedding, see docs/deploy.md.
EMBEDDINGS_PROVIDER=fake
VOYAGE_API_KEY=
# vercel-blob | local. The token is created with a Blob store in the Vercel dashboard
# (Storage > Blob); Vercel adds BLOB_READ_WRITE_TOKEN to the project for you.
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=
# resend | brevo | console. "resend" needs a key from https://resend.com/api-keys (and a verified
# domain); "brevo" (free tier, no own domain) needs a key from https://app.brevo.com/settings/keys/api
MAIL_PROVIDER=console
RESEND_API_KEY=
BREVO_API_KEY=
# Sender shown on verification and reset emails. For Resend it must use a domain you verified there; for Brevo it must be a verified single sender.
EMAIL_FROM="AI Job Hunter <noreply@example.com>"

# Country the candidate lives in (default Portugal): only remote jobs open to it (worldwide,
# Europe/EU/EMEA for a European country, or the country itself) are imported.
CANDIDATE_COUNTRY=Portugal
# Comma-separated job sources to ingest (default: himalayas,remotive,jobicy). Valid: himalayas,
# remotive, jobicy, arbeitnow, adzuna. Arbeitnow and Adzuna list country-located jobs, so they are off by default.
JOB_SOURCES=himalayas,remotive,jobicy

# Optional job source, only used when "adzuna" is in JOB_SOURCES. Free app id and key from
# https://developer.adzuna.com/ (the other sources need no key). Without them Adzuna is skipped.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Comma-separated Adzuna countries, at most 4 (default: es). Supported: at, au, be, br, ca, ch,
# de, es, fr, gb, in, it, mx, nl, nz, pl, sg, us, za. The Adzuna API has no Portugal.
ADZUNA_COUNTRIES=es

# Shared secret for POST /api/cron/ingest. Generate with: openssl rand -hex 32
# In production the same value goes in the GitHub Actions secret CRON_SECRET.
CRON_SECRET=replace-me

# Cloudflare Turnstile (demo button). Create a widget in the Cloudflare dashboard (Turnstile);
# it gives a site key (public) and a secret key. Not needed locally.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# true skips the Turnstile check. MUST be false in production.
TURNSTILE_BYPASS=true

# Hard cap on AI spend per UTC day, in USD, across all users. AI calls fail cleanly once it is reached.
GLOBAL_DAILY_AI_BUDGET_USD=5
